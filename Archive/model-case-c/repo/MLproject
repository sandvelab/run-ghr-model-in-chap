name: min_template_py_ex

meta_data:
  display_name: Minimal Template Python Example

allow_free_additional_continuous_covariates: true
required_covariates:
  - rainfall

user_options:
  alpha:
    type: float
    default: 1e-5

hpo_search_space:
  alpha: 
    values: [1e-5, 1e-4]

entry_points:
  train:
    command: python train.py {train_data} {model} {model_config}
    parameters:
      train_data: str
      model: str
      model_config: str
  predict:
    command: python predict.py {model} {historic_data} {future_data} {out_file} {model_config}
    parameters:
      model: str
      historic_data: str
      future_data: str
      out_file: str
      model_config: str
uv_env: pyproject.toml
